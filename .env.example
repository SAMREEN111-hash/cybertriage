# CyberTriage Environment Configuration
# Copy this to .env and fill in your values

# Database — SQLite (local) or PostgreSQL (production)
DATABASE_URL=sqlite+aiosqlite:///./cybertriage.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cybertriage

# JWT — change this to a random 32+ character string in production
SECRET_KEY=change-me-to-a-real-secret-in-production

# AbuseIPDB — optional, enables live IP threat intel
# Get a free API key at https://www.abuseipdb.com/account/api
# ABUSEIPDB_API_KEY=your_api_key_here
